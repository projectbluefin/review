#!/usr/bin/env bash
# The review engine.
#
# One contract, two entry points: this prepares a Review Draft for a human. It
# never approves, submits, or merges, and it offers no state-changing action at
# all — the maintainer surface (the dashboard) owns those, behind its own
# typed-number gate.
#
#   bluefin-review [range]           review a local diff through Goose
#   bluefin-review pr <repo> <num>   review one pull request through Goose
#
# The dashboard shells out to 'pr' for its review key, so both surfaces judge a
# change through exactly one code path.
set -euo pipefail

# 'goose review' exits 0 even when a check never returned a verdict: the model
# answers with prose or an empty response, the orchestrator prints
# "check '<name>' failed: parse check JSON: ..." and then reports the run's
# finding count as though that check had simply found nothing. Reading
# "0 finding(s)" off such a run and calling it clean is the worst outcome this
# tool can produce, so an incomplete review gets its own exit status.
REVIEW_INCOMPLETE=65
CHECK_FAILURE_PATTERN='^goose review: .+ failed: '

WORKSPACE="${HIVE_WORKSPACE_DIR:-${HOME}/workspace}"

# Goose discovers session skills under ~/.agents/skills, but 'goose review'
# does not read them: its own context comes from '.agents/REVIEW.md' and
# '.agents/checks/*.md' inside the REVIEWED repository. Reviewing another
# project therefore gets Goose's generic prompt with none of the org's review
# doctrine, and we must not write into the repository under review to fix that.
#
# --instructions is the additive seam (--prompt would replace Goose's default
# prompt wholesale). Pass a POINTER rather than the documents themselves: the
# projected pr-review skill and its references are ~33 KB, Goose dispatches one
# subprocess per check, and that cost would be paid on every check of every
# review. This mirrors local-agent-policy.md, which likewise routes the agent
# into the skill inventory instead of inlining it.
SKILLS_ROOT="${BLUEFIN_REVIEW_SKILLS_ROOT:-${HOME}/.agents/skills}"
CONTEXT_SKILLS="${BLUEFIN_REVIEW_CONTEXT_SKILLS:-pr-review queue-feed hive-review human-gates}"

# Hive downloads the hub's knowledge export here and refreshes it every ten
# minutes, symlinking it to the names Goose loads as context files. Naming the
# path explicitly means a review reaches the knowledge base even if a review
# subprocess does not inherit those context files.
KNOWLEDGE_FILE="${BLUEFIN_REVIEW_KNOWLEDGE_FILE:-${HOME}/agent.md}"

# The image-owned review scope. `goose review --check-scope <DIR>` loads
# .agents/REVIEW.md and .agents/checks/*.md from an out-of-tree directory, so
# Bluefin's review doctrine reaches every review without writing into the
# repository under review and without paying the --instructions text once per
# check subprocess. When the overlay is absent (running outside the image),
# reviews fall back to the --instructions pointer below.
SCOPE_ROOT="${BLUEFIN_REVIEW_SCOPE_ROOT:-/opt/bluefin/review-scope}"

# Open pull requests fetched per repository for duplicate detection. The busiest
# factory repository sits well under this; the analyzer says so explicitly when
# a pull request falls outside the page, so the limit can never be mistaken for
# a clean result.
PULL_FETCH_LIMIT="${BLUEFIN_REVIEW_PULL_LIMIT:-200}"

review_instructions() {
  local id skill listing=""
  for id in $CONTEXT_SKILLS; do
    skill="${SKILLS_ROOT}/${id}/SKILL.md"
    [[ -f "$skill" ]] || continue
    listing+="- ${id}: ${skill}"
    if compgen -G "${SKILLS_ROOT}/${id}/references/*.md" >/dev/null; then
      listing+=" (plus ${SKILLS_ROOT}/${id}/references/)"
    fi
    listing+=$'\n'
  done
  # Upstream writes a non-empty placeholder ("Knowledge base not yet
  # available.") when the hub fetch fails, so a size check alone would
  # announce a dead export as the knowledge base.
  if [[ -s "$KNOWLEDGE_FILE" ]] && ! grep -q 'Knowledge base not yet available' "$KNOWLEDGE_FILE"; then
    listing+="- hive knowledge base (refreshed from the hub): ${KNOWLEDGE_FILE}"$'\n'
  fi
  if [[ -z "$listing" ]]; then
    # No doctrine on disk, but a duplicate cluster and the maintainer's own
    # steering still need to reach Goose.
    [[ -n "${BLUEFIN_REVIEW_RELATED:-}" ]] && printf '%s' "$BLUEFIN_REVIEW_RELATED"
    [[ -n "${BLUEFIN_REVIEW_STEER:-}" ]] && printf '%s' "$(steer_instructions)"
    return 0
  fi

  printf '%s' "This is a Project Bluefin review. The org's review doctrine is on disk; read the entries that match this diff before judging it, and prefer them over general habit:
${listing}
Report findings with severity, file and line references, and the evidence for
each. State what you could not verify. If there are no evidenced findings, say
so plainly. A human makes every approval and merge decision; never present a
recommendation as one."
  # run_goose_review appends the duplicate cluster here so one review judges
  # every pull request doing the same work instead of just the one on screen.
  if [[ -n "${BLUEFIN_REVIEW_RELATED:-}" ]]; then
    printf '\n\n%s' "$BLUEFIN_REVIEW_RELATED"
  fi
  if [[ -n "${BLUEFIN_REVIEW_STEER:-}" ]]; then
    printf '\n\n%s' "$(steer_instructions)"
  fi
}

# The maintainer's own words for this one review, typed into the dashboard's
# steering box. Additive: it directs attention within the review, and can
# never license an approval, a merge, or any other state change.
steer_instructions() {
  printf '%s' "The maintainer is steering this review. Give this their explicit
attention, in addition to — never instead of — the checks above:

${BLUEFIN_REVIEW_STEER}

If the steering cannot be answered from the diff and the evidence available,
say so plainly rather than guessing. This still produces a Review Draft only:
a human makes every approval and merge decision."
}

# Run Goose and hold its output to account. 'goose review' reports a per-check
# failure on its own progress stream and then exits 0 regardless, so the run is
# scanned for checks that produced no verdict before its status is believed.
run_reviewed() {
  local log status=0 incomplete=0
  log="$(mktemp "${TMPDIR:-/tmp}/bluefin-review-log.XXXXXX")"
  # Merged, because the verdict and the progress reporting have to be read
  # together — and tee'd, because the reviewer still watches it stream.
  "$@" 2>&1 | tee "$log" || status=$?
  incomplete="$(grep -cE "$CHECK_FAILURE_PATTERN" "$log" 2>/dev/null)" || incomplete=0
  if ((incomplete > 0)); then
    report_incomplete_review "$log" "$incomplete"
    if ((status == 0)); then status="$REVIEW_INCOMPLETE"; fi
  fi
  rm -f "$log"
  return "$status"
}

# Name the parts of the review that never answered. A reviewer who is told
# "0 findings" by a run where two checks died has been handed a false clean.
report_incomplete_review() {
  local log="$1" failures="$2"
  printf '\n'
  rule
  printf ' REVIEW INCOMPLETE — %s part(s) of this review returned no verdict:\n' "$failures"
  grep -E "$CHECK_FAILURE_PATTERN" "$log" | sed -E 's/^goose review: /   - /' | cut -c1-160
  printf '\n This run'"'"'s finding count is not a clean bill of health: a check\n'
  printf ' that failed to answer cannot have found nothing. Re-run the review.\n'
  rule
}

# Every review goes through here so both entry points carry the same context.
# With the image overlay present, context travels as a check scope:
# --check-scope REPLACES repo-root discovery, so the scratch scope always
# carries the full static overlay plus the per-review cluster-resolution check
# when a duplicate cluster exists. Without the overlay, the --instructions
# pointer carries the same doctrine.
goose_review() {
  local -a argv=(goose review)
  local scope=""
  if [[ -d "${SCOPE_ROOT}/.agents" ]]; then
    scope="$(mktemp -d "${TMPDIR:-/tmp}/bluefin-review-scope.XXXXXX")"
    mkdir -p "${scope}/.agents/checks"
    cp "${SCOPE_ROOT}/.agents/REVIEW.md" "${scope}/.agents/REVIEW.md"
    cp "${SCOPE_ROOT}/.agents/checks/"*.md "${scope}/.agents/checks/"
    if [[ -n "${BLUEFIN_REVIEW_RELATED:-}" ]]; then
      {
        printf -- '---\nname: cluster-resolution\n---\n\n'
        printf '%s\n' "$BLUEFIN_REVIEW_RELATED"
        printf '\nName explicitly which pull request should merge and which should close as superseded, with evidence from the diffs.\n'
      } >"${scope}/.agents/checks/cluster-resolution.md"
    fi
    if [[ -n "${BLUEFIN_REVIEW_STEER:-}" ]]; then
      {
        printf -- '---\nname: maintainer-steering\n---\n\n'
        steer_instructions
        printf '\n'
      } >"${scope}/.agents/checks/maintainer-steering.md"
    fi
    argv+=(--check-scope "$scope")
  else
    local instructions
    instructions="$(review_instructions)"
    if [[ -n "$instructions" ]]; then argv+=(--instructions "$instructions"); fi
  fi

  local status=0
  run_reviewed "${argv[@]}" "$@" || status=$?
  if [[ -n "$scope" ]]; then rm -rf "$scope"; fi
  return "$status"
}

banner() {
  printf '%s\n' \
    '+------------------------+' \
    '| BLUEFIN REVIEW         |' \
    '| HUMAN DECISION REQUIRED|' \
    '+------------------------+'
}

die() {
  printf 'bluefin-review: %s\n' "$1" >&2
  exit 1
}

rule() { printf '%s\n' '--------------------------------------------------------------'; }

usage() {
  cat <<'EOF'
Usage:
  bluefin-review [range]              review a local diff through Goose
  bluefin-review pr <repo> <number>   review one pull request through Goose

'pr' clones the repository into the workspace, checks the pull request out,
and reviews it against its base. Pull requests doing the same work are
detected and judged as one cluster.

This command only ever produces a Review Draft for a human. It has no
approve, merge, comment, or close path. The maintainer surface — the
dashboard, 'just review-queue' — owns every state-changing action, behind a
typed pull-request-number confirmation.

Exit status: 0 review complete, 65 review incomplete (a check returned no
verdict — the finding count cannot be read as clean), other on failure.
EOF
}

# --- duplicate detection ------------------------------------------------------

# Two output modes: human lines for the evidence block, and '--numbers' for
# run_goose_review, which fetches each duplicate's diff so one review judges
# the whole cluster instead of walking the same work twice.
#
# Renovate opens a digest bump and a version bump for the same dependency, and
# several agents can close one issue from separate pull requests, so the queue
# carries real duplicates. Normalise a title down to the dependency it updates
# so those collapse onto one key.
#
# 'shares a file' is deliberately NOT treated as duplication: across the live
# queue that fires on 174 pairs, mostly unrelated changes touching one common
# workflow file, and drowns the ~13 real ones. It is reported separately as an
# ordering hazard.
DUPLICATE_ANALYZER='
import json, sys, re, itertools

numbers_only = sys.argv[1] == "--numbers"
if numbers_only:
    sys.argv.pop(1)
number = int(sys.argv[1])
prs = json.load(open(sys.argv[2]))

def subject(title):
    s = title.lower()
    s = re.sub(r"^\w+(\([^)]*\))?:\s*", "", s)
    for pattern in (
        r"update module\s+(\S+)",
        r"update dependency\s+(\S+)",
        r"update\s+(\S+)\s+docker\s+(?:tag|digest)",
        r"update\s+(\S+)\s+action",
        r"update\s+(\S+)\s+digest",
        r"update\s+(\S+)\s+to\s+v?[\d.]",
    ):
        found = re.search(pattern, s)
        if found:
            return re.sub(r":[^:/]*$", "", found.group(1).strip())
    return None

this = next((p for p in prs if p["number"] == number), None)
if this is None:
    # Outside the fetched page. Saying nothing here would read exactly like
    # "no duplicates found", which is the wrong conclusion to hand a reviewer.
    if not numbers_only:
        print("related\tnot among the %d open pull requests checked" % len(prs))
    sys.exit(0)

def issues(pr):
    return {r["number"] for r in (pr.get("closingIssuesReferences") or [])}

def paths(pr):
    return {f["path"] for f in (pr.get("files") or [])}

mine_subject, mine_issues, mine_paths = subject(this["title"]), issues(this), paths(this)
duplicates, overlaps = [], []
dup_numbers, overlap_numbers = [], []
for other in prs:
    if other["number"] == number:
        continue
    shared_issues = mine_issues & issues(other)
    if mine_subject and subject(other["title"]) == mine_subject:
        duplicates.append("#%d (same dependency %s)" % (other["number"], mine_subject))
        dup_numbers.append(other["number"])
    elif shared_issues:
        duplicates.append("#%d (both close #%d)" % (other["number"], sorted(shared_issues)[0]))
        dup_numbers.append(other["number"])
    elif mine_paths & paths(other):
        overlaps.append("#%d" % other["number"])
        overlap_numbers.append(str(other["number"]))

if numbers_only:
    print("dupes\t" + " ".join(str(n) for n in dup_numbers))
    print("overlaps\t" + " ".join(overlap_numbers))
elif duplicates:
    print("dupe-of\t" + ", ".join(duplicates[:6]))
if overlaps and not numbers_only:
    trailer = ", ..." if len(overlaps) > 6 else ""
    print("overlaps\t" + ", ".join(overlaps[:6]) + trailer)
'

# One 'gh pr list' per repository, cached for the session: the walk revisits a
# repository once per queued pull request, and re-fetching each time would turn
# a 0.7s call into dozens. A failed fetch is reported, never cached as an empty
# result -- "no duplicates" and "could not look" must not read the same.
repo_pulls() {
  local repo="$1" cache="${CACHE_DIR}/${1//\//_}.json"
  if [[ ! -f "$cache" ]]; then
    if ! gh pr list --repo "$repo" --state open --limit "$PULL_FETCH_LIMIT" \
      --json number,title,files,closingIssuesReferences >"$cache" 2>/dev/null; then
      rm -f "$cache"
      return 1
    fi
  fi
  printf '%s' "$cache"
}

# Put the pull request on disk in the Hive workspace and hand the diff to Goose.
# Clone once per repository, then reuse it; a review loop that re-cloned every
# time would spend its life in git rather than in review.
run_goose_review() {
  local repo="$1" number="$2"
  # Two statements, not one: within a single 'local', the later name is not yet
  # assigned when the earlier expansion runs, so a combined declaration expands
  # to an empty repository directory (and trips 'set -u').
  local name="${repo##*/}"
  local dir="${WORKSPACE}/${name}"

  mkdir -p "$WORKSPACE"
  if [[ ! -d "${dir}/.git" ]]; then
    printf 'cloning %s into %s\n' "$repo" "$dir"
    gh repo clone "$repo" "$dir" -- --quiet || {
      printf 'could not clone %s\n' "$repo" >&2
      return 1
    }
  fi

  (
    cd "$dir" || exit 1
    git fetch --quiet origin || true
    gh pr checkout "$number" --repo "$repo" || {
      printf 'could not check out %s#%s\n' "$repo" "$number" >&2
      exit 1
    }

    base="$(gh pr view "$number" --repo "$repo" --json baseRefName --jq .baseRefName)" || exit 1
    git fetch --quiet origin "$base" || true

    # Duplicates are the same work wearing another number, so one review must
    # judge the whole cluster: fetch each duplicate's diff and tell Goose to
    # name the one that should merge. Overlaps share only files, so they are
    # listed as ordering hazards without spending a review on them.
    local_related=""
    if [[ -n "${CACHE_DIR:-}" ]] && cache="$(repo_pulls "$repo")"; then
      dup_numbers=""
      overlap_numbers=""
      while IFS=$'\t' read -r kind nums; do
        case "$kind" in
          dupes) dup_numbers="$nums" ;;
          overlaps) overlap_numbers="$nums" ;;
        esac
      done < <(python3 -c "$DUPLICATE_ANALYZER" --numbers "$number" "$cache" 2>/dev/null)

      if [[ -n "$dup_numbers" ]]; then
        local_related="These pull requests are the SAME work as the one under review. Review them together and name explicitly which one should merge and which should close as superseded, with evidence from the diffs:"
        for dup in $dup_numbers; do
          diff_file="${CACHE_DIR}/related-${dup}.diff"
          if gh pr diff "$dup" --repo "$repo" >"$diff_file" 2>/dev/null && [[ -s "$diff_file" ]]; then
            local_related+=$'\n'"- #${dup}: full diff at ${diff_file}"
          else
            local_related+=$'\n'"- #${dup}: diff unavailable, read it on GitHub"
            rm -f "$diff_file"
          fi
        done
      fi
      if [[ -n "$overlap_numbers" ]]; then
        local_related+=$'\n'"These pull requests only share files with this one — a merge-ordering hazard, not duplicates; note conflicts but review them on their own stops: ${overlap_numbers}"
      fi
    fi

    banner
    BLUEFIN_REVIEW_RELATED="$local_related" goose_review "origin/${base}...HEAD"
  )
}

# --- entry -------------------------------------------------------------------

# Review one pull request. The cache directory backs the duplicate analysis, so
# a cluster is resolved from a single snapshot of the repository's open pull
# requests rather than one fetch per question.
pr_mode() {
  local repo="${1:-}" number="${2:-}"
  [[ -n "$repo" && -n "$number" ]] || die "usage: bluefin-review pr <owner/repo> <number>"
  [[ "$number" =~ ^[0-9]+$ ]] || die "not a pull request number: ${number}"
  command -v gh >/dev/null || die "gh is required to review a pull request"
  command -v jq >/dev/null || die "jq is required to review a pull request"

  CACHE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/bluefin-review.XXXXXX")"
  # A stopped review must actually stop. The EXIT trap cleans up; the signal
  # traps also leave, because a handler that only cleans up returns control to
  # the script and the run continues after the maintainer asked for it to end.
  trap 'rm -rf "$CACHE_DIR"' EXIT
  trap 'rm -rf "$CACHE_DIR"; trap - EXIT; exit 143' TERM
  trap 'rm -rf "$CACHE_DIR"; trap - EXIT; exit 130' INT

  local status=0
  run_goose_review "$repo" "$number" || status=$?
  if ((status == 0)); then
    printf '\nThe Review Draft above is for you to judge. Nothing was submitted.\n'
  elif ((status == REVIEW_INCOMPLETE)); then
    printf '\nThis review is INCOMPLETE — do not read it as clean. Nothing was submitted.\n'
  else
    printf '\nReview did not complete for %s#%s. Nothing was submitted.\n' "$repo" "$number"
  fi
  return "$status"
}

case "${1-}" in
  pr)
    shift
    pr_mode "$@"
    ;;
  -h | --help)
    usage
    ;;
  *)
    banner
    goose_review "$@"
    ;;
esac
