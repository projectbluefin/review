# review contributor image.
#
# This image is self-owned: it derives from Project Bluefin's FSDK lab-runner
# base and layers in only the runtime pieces review actually needs for
# contributor mode. We still reuse Hive's contributor runtime scripts, but we do
# not inherit the whole Debian-based contributor container any more.
#
# The base is pinned as tag *and* digest, and needs both. The digest is what
# builds and what tests/image-contract.sh asserts, so the base is immutable.
# The tag is what makes the pin trackable: Renovate's dockerfile manager has
# nothing to compare a bare digest against, so the tagless form this replaced
# was never once offered an update and silently froze. A pin no tool can track
# is not a stricter pin, it is a stale one. The reference below is the only
# source of truth for which base this is; do not restate its value here.
ARG FSDK_RUNNER_IMAGE=ghcr.io/projectbluefin/lab-runner:25.08@sha256:7c4b1e518bd1bffe2e506474e6196e9c18fb727bbd48a3c5f7ddbd3446ea5846
# Kept equal to justfile's hive_commit: host setup and the
# image runtime use the same contributor relay protocol revision.
ARG HIVE_COMMIT=0b78dc096d51ad7af7408fb644f40d269a7e4fc5
ARG NODE_VERSION=24.18.1
ARG GH_VERSION=2.97.0
ARG TMUX_VERSION=3.7b
ARG CODEX_VERSION=0.147.0
ARG CODEX_X86_64_SHA256=0246e2e773834e07f0fb5249ed6ebad12e4591e608f8c7bb97dd6a9690544c36
ARG CODEX_AARCH64_SHA256=eb677c80f666b1ab8b4b1d083b66e8d614b1281d960bb6f9fd8ca98f58b38b90
ARG CODEX_CODE_MODE_HOST_X86_64_SHA256=0146adfaac8363ec9fcdb5895f7624db5b2e8617a283887938b7fb97a1dd4356
ARG CODEX_CODE_MODE_HOST_AARCH64_SHA256=dfd4ff98ea4db30ed078af9c31b6f86e3da4836d0573aa87e225e5a5b54d3c7c
ARG GOOSE_CHANNEL=canary
ARG PI_VERSION=0.73.1
ARG PI_SHA512=817421dd26999964df54c738028e7e2c66d578abf3c8eeeda25a24d272ec660abd9c68d9c7f10453734cf02faa52707836fb36aecc06e6a39580bcd092ad1f1d
# `canary` is a mutable release tag, not an artifact identity. CI resolves
# these from the release asset API for every build and passes them as build
# inputs; these defaults keep a local build pinned to a known attested asset.
ARG GOOSE_X86_64_SHA256=db1ae20729ac87ebff0e55d161ec88515d92e580ddd1b0b4371a162f16d05180
ARG GOOSE_AARCH64_SHA256=187e0564d735cd99678f471c303546df64eafab6db851421781c96b8700e9792
ARG UV_VERSION=0.12.3
ARG UV_X86_64_SHA256=0643b9fb8c9fb27458e709ce6ff939695013c41975ff7b02d3f3b138d8d4bdb3
ARG UV_AARCH64_SHA256=fa513fca1eb2913334c944fe9adbdd410274a1cbe8dd05d03699a9eb85311d4e
ARG TEXTUAL_VERSION=8.2.8
ARG RIPGREP_VERSION=15.2.0
ARG RIPGREP_X86_64_SHA256=33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c
ARG RIPGREP_AARCH64_SHA256=800b1e7206afe799dfb5a6901f23147cfaabe0e52210538100f61e86e1740915
ARG SKILLS_COMMIT=b6f5c370cca19398fbbbe43a0182dca6783a80cb

FROM ${FSDK_RUNNER_IMAGE}

USER root

ARG NODE_VERSION
ARG GH_VERSION
ARG TMUX_VERSION
ARG CODEX_VERSION
ARG CODEX_X86_64_SHA256
ARG CODEX_AARCH64_SHA256
ARG CODEX_CODE_MODE_HOST_X86_64_SHA256
ARG CODEX_CODE_MODE_HOST_AARCH64_SHA256

ENV PATH=/opt/node/bin:${PATH}
ENV NODE_PATH=/opt/hive/node_modules
ENV HIVE_CONTRIBUTOR_MODE=true

# FSDK's shell-enabled base keeps the runtime lean but does not ship the whole
# contributor stack. Keep the pinned Node, GitHub CLI, tmux, and relay module
# together so a mutable Goose refresh reuses this fixed-tool layer.
#
# Every archive is checksum-verified with sha256sum BEFORE it is opened, and
# unpacked by the base's own GNU tar 1.35 -- not by a hand-rolled extractor.
#
# The `-I 'python3 -m gzip'` filter supplies the one codec this base lacks;
# tar keeps every archive semantic. Delete it when fsdk-containers#87 lands.
#
# GNU tar is what blocks path traversal and tar bombs here: without
# `-P`/`--absolute-names` it strips leading `/` and refuses any member
# containing `..`, and the single-file extracts never touch the filesystem at
# all -- `-xO` writes one member to stdout, so the archive cannot choose its
# own destination. Each archive is sha256-pinned above, so its exact bytes are
# known before tar sees them.
COPY package.json package-lock.json /opt/hive/
RUN set -eu; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) \
        node_arch=x64; \
        node_sha='d6c664df3f3f61458e8c277585571328522d705166723a7c7823a9253a4d15a0'; \
        gh_arch=amd64; \
        gh_sha='a2c9b8497e1f85b1ad0dfcb78b5a622e098801b8e461e459e88e1ee12f018112'; \
        tmux_arch=x86_64; \
        tmux_sha='f85e6c1c412750a774eb3f370f33bad05fc726fb8b6a0b174ad6f0b6d954df58'; \
        codex_arch=x86_64; \
        codex_sha="${CODEX_X86_64_SHA256}"; \
        codex_code_mode_host_sha="${CODEX_CODE_MODE_HOST_X86_64_SHA256}"; \
        loader_dir=/lib64; \
        loader_target=/usr/lib64/ld-linux-x86-64.so.2; \
        loader_name=ld-linux-x86-64.so.2 ;; \
      aarch64|arm64) \
        node_arch=arm64; \
        node_sha='7201e3a09dc825bac57867c81913e2b8f0ef87d04cb9082af4cda82f6ff3d88c'; \
        gh_arch=arm64; \
        gh_sha='73ea440ecad9c9e284429997ee6f93577bc6f7bc6fba357ef62c53ad8fb641a5'; \
        tmux_arch=arm64; \
        tmux_sha='b2955782695283fbc3682a2f77d65616f53b986ee3cf3d80618d3b1cb95b91a6'; \
        codex_arch=aarch64; \
        codex_sha="${CODEX_AARCH64_SHA256}"; \
        codex_code_mode_host_sha="${CODEX_CODE_MODE_HOST_AARCH64_SHA256}"; \
        loader_dir=/lib; \
        loader_target=/usr/lib/ld-linux-aarch64.so.1; \
        loader_name=ld-linux-aarch64.so.1 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    mkdir -p "$loader_dir"; \
    [ -e "${loader_dir}/${loader_name}" ] || ln -sf "$loader_target" "${loader_dir}/${loader_name}"; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    mkdir -p /usr/local/bin /opt/hive; \
    curl --fail --location --show-error --silent \
      "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
      -o "$workdir/node.tar.xz"; \
    printf '%s  %s\n' "$node_sha" "$workdir/node.tar.xz" | sha256sum -c -; \
    rm -rf /opt/node; \
    mkdir -p /opt/node; \
    tar --no-same-owner -xf "$workdir/node.tar.xz" -C /opt/node --strip-components=1; \
    curl --fail --location --show-error --silent \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" \
      -o "$workdir/gh.tar.gz"; \
    printf '%s  %s\n' "$gh_sha" "$workdir/gh.tar.gz" | sha256sum -c -; \
    tar -I 'python3 -m gzip' -xOf "$workdir/gh.tar.gz" --wildcards --occurrence=1 '*/bin/gh' > /usr/local/bin/gh; \
    chmod 0755 /usr/local/bin/gh; \
    curl --fail --location --show-error --silent \
      "https://github.com/tmux/tmux-builds/releases/download/v${TMUX_VERSION}/tmux-${TMUX_VERSION}-linux-${tmux_arch}.tar.gz" \
      -o "$workdir/tmux.tar.gz"; \
    printf '%s  %s\n' "$tmux_sha" "$workdir/tmux.tar.gz" | sha256sum -c -; \
    tar -I 'python3 -m gzip' -xOf "$workdir/tmux.tar.gz" --occurrence=1 tmux > /usr/local/bin/tmux; \
    chmod 0755 /usr/local/bin/tmux; \
    curl --fail --location --show-error --silent \
      "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-${codex_arch}-unknown-linux-musl.tar.gz" \
      -o "$workdir/codex.tar.gz"; \
    printf '%s  %s\n' "$codex_sha" "$workdir/codex.tar.gz" | sha256sum -c -; \
    tar -I 'python3 -m gzip' -xOf "$workdir/codex.tar.gz" --occurrence=1 \
      "codex-${codex_arch}-unknown-linux-musl" > /usr/local/bin/codex; \
    chmod 0755 /usr/local/bin/codex; \
    curl --fail --location --show-error --silent \
      "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-code-mode-host-${codex_arch}-unknown-linux-musl.tar.gz" \
      -o "$workdir/codex-code-mode-host.tar.gz"; \
    printf '%s  %s\n' "$codex_code_mode_host_sha" "$workdir/codex-code-mode-host.tar.gz" | sha256sum -c -; \
    tar -I 'python3 -m gzip' -xOf "$workdir/codex-code-mode-host.tar.gz" --occurrence=1 \
      "codex-code-mode-host-${codex_arch}-unknown-linux-musl" > /usr/local/bin/codex-code-mode-host; \
    chmod 0755 /usr/local/bin/codex-code-mode-host; \
    npm --prefix /opt/hive ci --omit=dev --ignore-scripts; \
    npm_cache="$(npm config get cache)"; \
    npm cache clean --force; \
    test ! -e "$npm_cache/_cacache"; \
    rm -rf "$npm_cache"; \
    test ! -e "$npm_cache"; \
    test ! -e /root/.npm; \
    rm -rf /opt/node/include /opt/node/share/doc; \
    test ! -e /opt/node/include; \
    test ! -e /opt/node/share/doc; \
    node --version; \
    npm --version; \
    corepack --version; \
    gh --version; \
    tmux -V; \
    codex --version; \
    codex-code-mode-host --help >/dev/null

# The agent tooling delta approved by #75: `rg`, under its own native name.
# ShellCheck and the other linters stay out; they are fsdk-containers#89.
#
# `just` and mikefarah `yq` v4 are absent from this layer because the base
# ships both, and a second copy here would precede the base's on PATH.
# Unpacked: 5.4 MB on amd64, 4.5 MB on arm64.
ARG RIPGREP_VERSION
ARG RIPGREP_X86_64_SHA256
ARG RIPGREP_AARCH64_SHA256
RUN set -eu; \
    # The anti-duplication contract: if the base ever ships rg, delete this
    # layer rather than shadow it. Probe PATH *and* a fixed directory list.
    # Neither alone is enough: PATH here is root's build PATH, which misses a
    # copy the runtime user would still see, while the directory list misses
    # PATH entries outside it -- /opt/node/bin above is prepended to PATH, so
    # an rg there would beat /usr/local/bin/rg at runtime.
    if command -v rg >/dev/null 2>&1; then \
      echo "rg is already provided at $(command -v rg); delete this layer instead of shadowing it" >&2; \
      exit 1; \
    fi; \
    for dir in /usr/bin /usr/sbin /bin /sbin /usr/local/bin /usr/local/sbin; do \
      if [ -e "$dir/rg" ]; then \
        echo "rg is already provided by the base at $dir/rg; delete this layer instead of shadowing it" >&2; \
        exit 1; \
      fi; \
    done; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) \
        rg_arch=x86_64-unknown-linux-musl; \
        rg_sha="${RIPGREP_X86_64_SHA256}" ;; \
      aarch64|arm64) \
        rg_arch=aarch64-unknown-linux-musl; \
        rg_sha="${RIPGREP_AARCH64_SHA256}" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    curl --fail --location --show-error --silent \
      "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/ripgrep-${RIPGREP_VERSION}-${rg_arch}.tar.gz" \
      -o "$workdir/ripgrep.tar.gz"; \
    printf '%s  %s\n' "$rg_sha" "$workdir/ripgrep.tar.gz" | sha256sum -c -; \
    # Decompress whole, then select the member. Piping the codec into tar
    # deadlocks here: `--occurrence=1` stops reading once it has `rg`, and the
    # `python3 -m gzip` filter dies on the resulting SIGPIPE rather than
    # exiting quietly the way the gzip binary would. The checksum is verified
    # above, before either read of the archive.
    python3 -m gzip -d < "$workdir/ripgrep.tar.gz" > "$workdir/ripgrep.tar"; \
    tar -xOf "$workdir/ripgrep.tar" --wildcards --occurrence=1 '*/rg' > /usr/local/bin/rg; \
    chmod 0755 /usr/local/bin/rg; \
    rg --version; \
    # Standard command semantics stay the base's. Nothing in this layer may
    # resolve grep, find, cat, or ls out of /usr/local/bin.
    for canonical in grep find cat ls; do \
      case "$(command -v "$canonical")" in \
        /usr/local/bin/*) echo "$canonical is shadowed from /usr/local/bin" >&2; exit 1 ;; \
      esac; \
    done; \
    printf 'x\ny\n' > "$workdir/probe.txt"; \
    test "$(rg --count-matches y "$workdir/probe.txt")" = 1

# The maintainer TUI runtime: uv (pinned, checksum-verified) creates a
# self-contained virtual environment on the base's own CPython and installs
# Textual from the hash-locked requirements file. uv stays installed at
# /usr/local/bin/uv; the venv lives under /opt/bluefin/tui and is never on
# PATH, so nothing here shadows base tools.
ARG UV_VERSION
ARG UV_X86_64_SHA256
ARG UV_AARCH64_SHA256
ARG TEXTUAL_VERSION
COPY --chmod=0644 image/tui/requirements.lock /opt/bluefin/tui/requirements.lock
# Every module, not just the entrypoint: the dashboard imports its siblings
# (review_result, and theirs in turn) by bare name off sys.path[0]. A glob so
# a new module ships the moment it exists, rather than the next time someone
# remembers to extend this line.
COPY --chmod=0644 image/tui/*.py /opt/bluefin/tui/
COPY --chmod=0644 image/harness/*.py /opt/bluefin/harness/
RUN set -eu; \
    # The mode a builder gives a parent directory it creates for a COPY
    # --chmod is not the same everywhere: buildah uses 0755, BuildKit copies
    # the file's mode, so the 0644 copies above once produced /opt/bluefin
    # and /opt/bluefin/tui with no execute bit. Root ignored it for the rest
    # of the build, the unprivileged 'dev' user could not traverse into any
    # image-owned tree underneath, and Goose died reading its GOOSE_PATH_ROOT
    # config. State the mode rather than inherit one; the layer near the end
    # of this file asserts the whole tree.
    chmod 0755 /opt/bluefin /opt/bluefin/tui /opt/bluefin/harness; \
    chmod 0644 /opt/bluefin/harness/*.py; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) uv_arch=x86_64-unknown-linux-musl; uv_sha="${UV_X86_64_SHA256}" ;; \
      aarch64|arm64) uv_arch=aarch64-unknown-linux-musl; uv_sha="${UV_AARCH64_SHA256}" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    curl --fail --location --show-error --silent \
      "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}.tar.gz" \
      -o "$workdir/uv.tar.gz"; \
    printf '%s  %s\n' "$uv_sha" "$workdir/uv.tar.gz" | sha256sum -c -; \
    python3 -m gzip -d < "$workdir/uv.tar.gz" > "$workdir/uv.tar"; \
    tar -xOf "$workdir/uv.tar" --wildcards --occurrence=1 '*/uv' > /usr/local/bin/uv; \
    chmod 0755 /usr/local/bin/uv; \
    uv --version; \
    grep -q "^textual==${TEXTUAL_VERSION}" /opt/bluefin/tui/requirements.lock; \
    UV_CACHE_DIR="$workdir/uv-cache" uv venv --python "$(command -v python3)" /opt/bluefin/tui/.venv; \
    UV_CACHE_DIR="$workdir/uv-cache" uv pip install \
      --python /opt/bluefin/tui/.venv/bin/python \
      --require-hashes --no-deps \
      -r /opt/bluefin/tui/requirements.lock; \
    /opt/bluefin/tui/.venv/bin/python -c "import textual; print(textual.__version__)"; \
    /opt/bluefin/tui/.venv/bin/python -m compileall -q /opt/bluefin/tui/*.py; \
    for tui_module in /opt/bluefin/tui/*.py; do \
      PYTHONPATH=/opt/bluefin/tui /opt/bluefin/tui/.venv/bin/python \
        -c "import $(basename "$tui_module" .py)"; \
    done; \
    test ! -e /root/.cache/uv

ARG GOOSE_CHANNEL
ARG GOOSE_X86_64_SHA256
ARG GOOSE_AARCH64_SHA256
ARG HIVE_COMMIT
ARG PI_VERSION
ARG PI_SHA512
# Preserve both architecture-specific asset identities in the image
# configuration. Build provenance records the resolved build arguments too.
LABEL io.projectbluefin.review.goose.channel="${GOOSE_CHANNEL}" \
      io.projectbluefin.review.goose.x86_64-unknown-linux-musl.sha256="${GOOSE_X86_64_SHA256}" \
      io.projectbluefin.review.goose.aarch64-unknown-linux-musl.sha256="${GOOSE_AARCH64_SHA256}"

# Keep Goose's mutable canary refresh in its own layer, after fixed tools.
ARG GOOSE_REFRESH=0
RUN --mount=type=secret,id=github_token set -eu; \
    export GH_TOKEN="$(cat /run/secrets/github_token)"; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) \
        goose_arch=x86_64; \
        goose_sha="${GOOSE_X86_64_SHA256}" ;; \
      aarch64|arm64) \
        goose_arch=aarch64; \
        goose_sha="${GOOSE_AARCH64_SHA256}" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    curl --fail --location --show-error --silent \
      "https://github.com/aaif-goose/goose/releases/download/${GOOSE_CHANNEL}/goose-${goose_arch}-unknown-linux-musl.tar.gz" \
      -o "$workdir/goose.tar.gz"; \
    printf '%s  %s\n' "$goose_sha" "$workdir/goose.tar.gz" | sha256sum -c -; \
    gh attestation verify "$workdir/goose.tar.gz" --repo aaif-goose/goose --signer-workflow aaif-goose/goose/.github/workflows/canary.yml; \
    python3 -m gzip -d < "$workdir/goose.tar.gz" > "$workdir/goose.tar"; \
    tar -xOf "$workdir/goose.tar" --occurrence=1 ./goose > /usr/local/bin/goose; \
    chmod 0755 /usr/local/bin/goose; \
    /usr/local/bin/goose --version; \
    /usr/local/bin/goose run --help >/dev/null

# Pi is the only additional backend in this image. Download the exact npm
# tarball and verify its registry integrity before npm installs it; no mutable
# package tag or unverified executable is allowed into the contributor image.
RUN set -eu; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    curl --fail --location --show-error --silent \
      "https://registry.npmjs.org/@mariozechner/pi-coding-agent/-/pi-coding-agent-${PI_VERSION}.tgz" \
      -o "$workdir/pi.tgz"; \
    printf '%s  %s\n' "$PI_SHA512" "$workdir/pi.tgz" | sha512sum -c -; \
    npm install --global --ignore-scripts --no-audit --no-fund "$workdir/pi.tgz"; \
    command -v pi; \
    pi --version

COPY --chmod=0755 image/bin/bluefin-review /usr/local/bin/bluefin-review
COPY --chmod=0755 image/bin/worktree-guard /usr/local/bin/worktree-guard

# The base ships the full ncurses terminfo database (fsdk-containers#101):
# TERM inside the container is the truth about the attached terminal, and
# the direct-color entries make 24-bit color a terminfo fact rather than a
# tmux terminal-features override. Fail the build if the base regresses.
RUN set -eu; \
    infocmp xterm-256color >/dev/null; \
    infocmp tmux-256color >/dev/null; \
    infocmp xterm-direct >/dev/null; \
    infocmp tmux-direct >/dev/null; \
    infocmp -x tmux-direct | grep -q 'RGB'

# Pull the contributor-mode runtime directly from the pinned Hive commit. The
# launcher still depends on Hive's relay protocol and tmux contract; we just own
# the surrounding image now.
RUN set -eu; \
    mkdir -p /usr/local/etc/hive /etc/hive/restrictions; \
    curl --fail --location --show-error --silent \
      "https://raw.githubusercontent.com/kubestellar/hive/${HIVE_COMMIT}/bin/contributor-agent.sh" \
      -o /usr/local/bin/contributor-agent.sh; \
    curl --fail --location --show-error --silent \
      "https://raw.githubusercontent.com/kubestellar/hive/${HIVE_COMMIT}/bin/contributor-relay.sh" \
      -o /usr/local/bin/contributor-relay.sh; \
    curl --fail --location --show-error --silent \
      "https://raw.githubusercontent.com/kubestellar/hive/${HIVE_COMMIT}/config/backends.conf" \
      -o /usr/local/etc/hive/backends.conf; \
    chmod 0755 /usr/local/bin/contributor-agent.sh /usr/local/bin/contributor-relay.sh

# Create the non-root runtime user expected by the launcher and workflows.
RUN set -eu; \
    grep -q '^dev:' /etc/group || echo 'dev:x:1000:' >> /etc/group; \
    grep -q '^dev:' /etc/passwd || echo 'dev:x:1000:1000:Developer:/home/dev:/usr/bin/bash' >> /etc/passwd; \
    mkdir -p /run/hive-metrics /home/dev/Downloads /home/dev/.config/goose /home/dev/.config/gh /home/dev/.codex /home/dev/.agents; \
    chown -R 1000:1000 /run/hive-metrics /home/dev

# Hive's contributor runtime calls `find` and `cmp` directly: the relay prunes
# /tmp every ten minutes with a full GNU expression, and the knowledge refresh
# compares AGENTS.md with `cmp -s`. review used to ship 214 lines of Python
# shims for both, justified as filling a gap in a lean base that omitted
# findutils and diffutils.
#
# That justification was wrong by the time it was load-bearing. PATH in this
# base is /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin, and
# the shims installed to /usr/local/bin/find and /usr/local/bin/cmp -- which
# PRECEDES /usr/sbin, where the base ships real GNU findutils 4.10.0 and
# diffutils 3.12. So the shims were not filling a gap, they were SHADOWING
# working GNU tools with a strictly weaker subset that failed loudly on any
# predicate outside it, and silently got one inside it wrong: the shim bound
# `-o` looser than GNU, so the relay's file sweep handed `-exec rm -f` paths
# real find leaves alone. Deleting them is a correctness fix, not a cleanup.
#
# Missing userland belongs at the FSDK seam, not in a shim here, so this layer
# asserts the seam held rather than patching around it. Both expressions below
# are verbatim from the pinned Hive commit's bin/contributor-relay.sh and
# bin/contributor-agent.sh, run as the `dev` user the relay runs as -- which
# is why this layer sits after that user is created. A base that drops either
# tool, or anything that shadows them from /usr/local/bin again, fails the
# build here instead of failing silently at runtime under the relay's
# discarded stderr.
RUN set -eu; \
    case "$(command -v find)" in /usr/local/bin/*) echo 'find must come from the base, not a shim' >&2; exit 1 ;; esac; \
    case "$(command -v cmp)" in /usr/local/bin/*) echo 'cmp must come from the base, not a shim' >&2; exit 1 ;; esac; \
    probe="$(mktemp -d)"; \
    install -d -o dev "$probe/stale-dir" "$probe/tmux-1" "$probe/fresh-dir"; \
    install -o dev /dev/null "$probe/a.out"; \
    install -o dev /dev/null "$probe/b.html"; \
    install -o dev /dev/null "$probe/c.txt"; \
    touch -d '3 hours ago' "$probe/stale-dir" "$probe/tmux-1" "$probe/a.out" "$probe/b.html" "$probe/c.txt"; \
    find "$probe" -maxdepth 1 -type d -user dev -not -name 'tmux-*' -not -name 'claude-*' -not -name 'node-*' -not -name '.' -mmin +60 -exec rm -rf {} + 2>/dev/null; \
    find "$probe" -maxdepth 1 -type f -user dev -name '*.out' -o -name '*.html' -mmin +60 -exec rm -f {} + 2>/dev/null; \
    test ! -e "$probe/stale-dir"; \
    test -d "$probe/tmux-1"; \
    test -d "$probe/fresh-dir"; \
    test ! -e "$probe/b.html"; \
    test -e "$probe/c.txt"; \
    test "$(find "$probe" -maxdepth 1 -type f -name 'c.txt')" = "$probe/c.txt"; \
    find "$probe" -maxdepth 1 -type f -name 'c.txt' -exec rm -f {} +; \
    test ! -e "$probe/c.txt"; \
    printf 'same\n' > "$probe/cmp-left"; \
    cp "$probe/cmp-left" "$probe/cmp-right"; \
    cmp -s "$probe/cmp-left" "$probe/cmp-right"; \
    printf 'different\n' > "$probe/cmp-right"; \
    ! cmp -s "$probe/cmp-left" "$probe/cmp-right"; \
    test -z "$(cmp -s "$probe/cmp-left" "$probe/cmp-right" 2>&1 || true)"; \
    rm -rf "$probe"

# Controlled Goose configuration. This is NOT ~/.config/goose/config.yaml:
# Hive's contributor runtime overwrites that file at every startup, so the
# entrypoint points Goose here with GOOSE_PATH_ROOT instead.
# GOOSE_PATH_ROOT relocates Goose's config AND its data/state roots, so the
# whole tree must be writable by the runtime user or Goose fails to open its
# log directory on startup.
RUN mkdir -p /opt/bluefin/goose/config /opt/bluefin/goose/data /opt/bluefin/goose/state \
    && chown -R 1000:1000 /opt/bluefin/goose
COPY --chown=1000:1000 image/config/goose.yaml /opt/bluefin/goose/config/config.yaml
COPY image/config/local-agent-policy.md /opt/bluefin/local-agent-policy.md

# The image-owned review scope: `goose review --check-scope` loads
# .agents/REVIEW.md and .agents/checks/*.md from this out-of-tree directory,
# so Bluefin's review doctrine reaches every review without writing into the
# repository under review. --check-scope REPLACES repo-root discovery
# (additive flag filed as aaif-goose/goose#11060), so Bluefin repositories
# keep their checks in this shared overlay.
COPY --chmod=0644 image/review-scope/REVIEW.md /opt/bluefin/review-scope/.agents/REVIEW.md
COPY --chmod=0644 image/review-scope/checks/ /opt/bluefin/review-scope/.agents/checks/
RUN chmod 0755 /opt/bluefin/review-scope /opt/bluefin/review-scope/.agents /opt/bluefin/review-scope/.agents/checks

# Git hooks, wired via a global core.hooksPath by the entrypoint. Ergonomics
# only -- `git commit --no-verify` bypasses every one of them.
COPY --chmod=0755 image/git-hooks/ /opt/bluefin/git-hooks/
COPY --chmod=0755 image/hive-entrypoint.d/ /etc/hive/entrypoint.d/

# The image runs as the unprivileged 'dev' user, and every tree under
# /opt/bluefin is image-owned policy that user must read: the Goose config at
# GOOSE_PATH_ROOT, the TUI venv, the harness, the review scope, the git hooks.
# Root ignores a missing execute bit, so a directory a builder created at 0644
# passes the rest of the build and only fails once a real session tries to
# traverse it. Assert the whole tree here instead.
RUN set -eu; \
    unreadable="$(find /opt/bluefin \( \( -type d ! -perm -o=rx \) -o \( -type f ! -perm -o=r \) \) -print)"; \
    [ -z "$unreadable" ] || { \
      echo 'not reachable by the dev user:' >&2; \
      echo "$unreadable" >&2; \
      exit 1; \
    }

# Project the org's skill documents into Goose's native Agent Skills layout.
#
# projectbluefin keeps skills as docs/skills/<id>.md plus a generated
# index.json; Goose only discovers directories containing SKILL.md, under fixed
# roots. Generating at build time means every session sees the whole inventory
# (name + description only, ~2k tokens) with bodies loaded on demand, and no
# org repository has to change.
ARG SKILLS_COMMIT
ARG SKILLS_REFRESH=0
COPY --chmod=0755 scripts/generate-skills.py /usr/local/libexec/review-generate-skills
RUN set -eu; \
    : "$SKILLS_REFRESH"; \
    /usr/local/libexec/review-generate-skills \
      --index "https://raw.githubusercontent.com/projectbluefin/common/${SKILLS_COMMIT}/docs/skills/index.json" \
      --raw-base "https://raw.githubusercontent.com/projectbluefin/common/${SKILLS_COMMIT}/" \
      --out /home/dev/.agents/skills; \
    chown -R 1000:1000 /home/dev/.agents; \
    rm -f /usr/local/libexec/review-generate-skills; \
    test ! -e /usr/local/libexec/review-generate-skills

# Bundle the projectbluefin/lab skills through the same seam. lab already
# keeps its skills in Goose's native docs/skills/<id>/SKILL.md layout, so
# this is a pinned checkout projected into the discovery root — one seam,
# no second generator. These carry the Ghost Cluster operating knowledge the
# dashboard's build dispatch (#133) depends on.
ARG LAB_SKILLS_COMMIT=8c56a80df0cfee20985d1e1197b768d640987ee7
RUN set -eu; \
    workdir="$(mktemp -d)"; \
    trap 'rm -rf "$workdir"' EXIT; \
    curl --fail --location --show-error --silent \
      "https://codeload.github.com/projectbluefin/lab/tar.gz/${LAB_SKILLS_COMMIT}" \
      -o "$workdir/lab.tar.gz"; \
    python3 -m gzip -d < "$workdir/lab.tar.gz" > "$workdir/lab.tar"; \
    mkdir -p "$workdir/lab"; \
    tar --no-same-owner -xf "$workdir/lab.tar" -C "$workdir/lab" --strip-components=1 \
      "lab-${LAB_SKILLS_COMMIT}/docs/skills"; \
    for skill in "$workdir"/lab/docs/skills/*/; do \
      id="$(basename "$skill")"; \
      [ "$id" = _template ] && continue; \
      [ -f "${skill}SKILL.md" ] || continue; \
      mkdir -p "/home/dev/.agents/skills/lab-${id}"; \
      cp -R "$skill". "/home/dev/.agents/skills/lab-${id}/"; \
    done; \
    test -f /home/dev/.agents/skills/lab-cluster-tooling/SKILL.md; \
    test ! -e /home/dev/.agents/skills/lab-_template; \
    chown -R 1000:1000 /home/dev/.agents

COPY --chmod=0755 image/entrypoint.sh /usr/local/bin/review-entrypoint
COPY image/tmux.conf /etc/tmux.conf

USER dev
WORKDIR /home/dev
ENTRYPOINT ["/usr/local/bin/review-entrypoint"]
