#!/usr/bin/env bash
# Entrypoint for omp in dedicated Bluefin review / issues mode.
set -euo pipefail

# 1. Resolve GitHub API token transparently from gh CLI if not explicitly set
if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  if command -v gh &>/dev/null; then
    RESOLVED_GH_TOKEN="$(gh auth token 2>/dev/null || true)"
    if [[ -n "$RESOLVED_GH_TOKEN" ]]; then
      export GH_TOKEN="$RESOLVED_GH_TOKEN"
      export GITHUB_TOKEN="$RESOLVED_GH_TOKEN"
    fi
  fi
fi

# 2. Resolve Copilot token transparently from environment or keyring
if [[ -z "${COPILOT_GITHUB_TOKEN:-}" && -z "${GITHUB_COPILOT_TOKEN:-}" ]]; then
  if command -v secret-tool &>/dev/null; then
    RESOLVED_COPILOT="$(secret-tool lookup service github-copilot username token 2>/dev/null || secret-tool lookup service omp username copilot 2>/dev/null || true)"
    if [[ -n "$RESOLVED_COPILOT" ]]; then
      export COPILOT_GITHUB_TOKEN="$RESOLVED_COPILOT"
      export GITHUB_COPILOT_TOKEN="$RESOLVED_COPILOT"
    fi
  fi
fi
# 3. Fallback: resolve token from host omp auth database in ~/.omp/agent/agent.db
if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" && -z "${COPILOT_GITHUB_TOKEN:-}" && -z "${GITHUB_COPILOT_TOKEN:-}" ]]; then
  if command -v python3 &>/dev/null; then
    RESOLVED_OMP_TOKEN="$(python3 -c '
import sqlite3, os, json
db_path = os.path.expanduser("~/.omp/agent/agent.db")
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        for prov in ("github-copilot", "github"):
            row = cur.execute("SELECT data FROM auth_credentials WHERE provider = ?", (prov,)).fetchone()
            if row:
                d = json.loads(row[0])
                tok = d.get("access") or d.get("token") or d.get("access_token")
                if tok:
                    print(tok)
                    break
    except Exception:
        pass
' 2>/dev/null || true)"
    if [[ -n "$RESOLVED_OMP_TOKEN" ]]; then
      export COPILOT_GITHUB_TOKEN="$RESOLVED_OMP_TOKEN"
      export GITHUB_COPILOT_TOKEN="$RESOLVED_OMP_TOKEN"
      export GH_TOKEN="$RESOLVED_OMP_TOKEN"
      export GITHUB_TOKEN="$RESOLVED_OMP_TOKEN"
    fi
  fi
fi

# If COPILOT_GITHUB_TOKEN is still unset, fall back to GH_TOKEN so GitHub API provider can auth
if [[ -z "${COPILOT_GITHUB_TOKEN:-}" && -n "${GH_TOKEN:-}" ]]; then
  export COPILOT_GITHUB_TOKEN="$GH_TOKEN"
fi
# 3. Ensure all spawned subagents, subprocesses, and tool bridges inherit credentials
export GH_TOKEN="${GH_TOKEN:-}"
export GITHUB_TOKEN="${GITHUB_TOKEN:-}"
export COPILOT_GITHUB_TOKEN="${COPILOT_GITHUB_TOKEN:-}"
export GITHUB_COPILOT_TOKEN="${GITHUB_COPILOT_TOKEN:-}"
export CONTEXT7_API_KEY="${CONTEXT7_API_KEY:-}"
# Pin Copilot client identity to developer CLI so Gemini/Kimi models are permitted by GitHub Copilot
export COPILOT_INTEGRATION_ID="${COPILOT_INTEGRATION_ID:-copilot-developer-cli}"

# 4. Resolve Hive Hub and ensure Hive knowledge export is available
if [[ -z "${HIVE_HUB:-}" ]]; then
  HIVE_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hive"
  if [[ -f "${HIVE_CONFIG_DIR}/contributor.env" ]]; then
    RESOLVED_HUB="$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?HIVE_HUB=[[:space:]]*["'\'']?([^"'\'']+)["'\'']?/\2/p' "${HIVE_CONFIG_DIR}/contributor.env" | head -1 || true)"
    if [[ -n "$RESOLVED_HUB" ]]; then
      export HIVE_HUB="$RESOLVED_HUB"
    fi
  fi
fi

if [[ -n "${HIVE_HUB:-}" && -n "${GH_TOKEN:-}" ]]; then
  HUB_HTTP="${HIVE_HUB/wss:\/\//https://}"
  HUB_ROOT="${HUB_HTTP%/contribute}"
  KNOWLEDGE_FILE="${HOME}/agent.md"
  # Refresh knowledge export if missing or older than 10 minutes
  if [[ ! -s "$KNOWLEDGE_FILE" ]] || test $(($(date +%s) - $(date -r "$KNOWLEDGE_FILE" +%s 2>/dev/null || echo 0))) -gt 600; then
    curl -sf --max-time 15 -H "Authorization: Bearer ${GH_TOKEN}" \
      "${HUB_ROOT}/api/v1/knowledge" -o "${KNOWLEDGE_FILE}.tmp" 2>/dev/null || \
    curl -sf --max-time 15 \
      "${HUB_ROOT}/api/knowledge/export" -o "${KNOWLEDGE_FILE}.tmp" 2>/dev/null || true
    if [[ -s "${KNOWLEDGE_FILE}.tmp" ]]; then
      mv -f "${KNOWLEDGE_FILE}.tmp" "$KNOWLEDGE_FILE"
    else
      rm -f "${KNOWLEDGE_FILE}.tmp"
    fi
  fi
fi
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# The mode ships as an extension package directory: index.ts plus the companion
# agents omp discovers under <extension-root>/agents.
EXTENSION_PATH="${BLUEFIN_REVIEW_EXTENSION_PATH:-/opt/bluefin/extensions/bluefin-review}"
if [[ ! -e "$EXTENSION_PATH" && -d "$SCRIPT_DIR/image/extension/bluefin-review" ]]; then
  EXTENSION_PATH="$SCRIPT_DIR/image/extension/bluefin-review"
fi
if [[ ! -e "$EXTENSION_PATH" ]]; then
  echo "omp-review: review extension not found at $EXTENSION_PATH" >&2
  exit 1
fi

# 5. Ensure organization & repository skills are projected for agent discovery
if [[ -f "$SCRIPT_DIR/docs/skills/index.json" && -f "$SCRIPT_DIR/scripts/generate-skills.py" ]]; then
  python3 "$SCRIPT_DIR/scripts/generate-skills.py" \
    --index "$SCRIPT_DIR/docs/skills/index.json" \
    --raw-base "$SCRIPT_DIR" \
    --out "$SCRIPT_DIR/.agents/skills" \
    --allow-empty &>/dev/null || true
fi

# Positional shortcuts, so the common cases need no flags. A leading number
# preselects that queue item, `owner/repo` scopes the queue to one repository,
# and `issues` starts on issues. Everything after is passed to omp untouched.
ARGS=()
if [[ "${1:-}" =~ ^#?[0-9]+$ ]]; then
  ARGS+=(--pr "${1#\#}")
  shift
elif [[ "${1:-}" =~ ^(https://github\.com/)?[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ || "${1:-}" =~ ^org:[A-Za-z0-9._-]+$ ]]; then
  ARGS+=(--repo "$1")
  shift
  if [[ "${1:-}" =~ ^#?[0-9]+$ ]]; then
    ARGS+=(--pr "${1#\#}")
    shift
  fi
fi
if [[ "${1:-}" == "issues" ]]; then
  ARGS+=(--issues)
  shift
elif [[ "${1:-}" == "all" ]]; then
  ARGS+=(--all)
  shift
elif [[ "${1:-}" == "autoslay" || "${1:-}" == "slay" ]]; then
  ARGS+=(--autoslay)
  shift
fi

exec omp --profile review --extension "$EXTENSION_PATH" ${ARGS[@]+"${ARGS[@]}"} "$@"
