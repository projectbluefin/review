# Release archives are fetched and verified during the image build; do not
# retain them in the source tree.
goose-*.tar.gz
.worktrees/
image/bluefin-operations/node_modules/

# queue/generate.mjs writes these on every run and the workflow deploys them
# from a fresh checkout; public/index.html is hand-authored, so it stays.
public/queue.json
public/queue.md

# tests/image-audit.sh --report writes generated audit reports; they are
# per-run evidence, never source.
image-audit-report.md
__pycache__/

# tests/dashboard-contract.sh builds a pinned Textual venv here to drive the
# dashboard pilot; it is a build artifact, never source.
.cache/
